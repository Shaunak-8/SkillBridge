# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=skillbridge
NEXT_PUBLIC_DEMO_MODE=true

# Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
APP_URL=http://localhost:3000
LLM_API_KEY=
EMBEDDING_API_KEY=

# Supabase
# Create these values in Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase secret. Never expose this to browser code.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini (server-only; never expose to the browser)
GEMINI_API_KEY=
# AI quiz generation and grading (server-only). Falls back to GEMINI_API_KEY when empty.
GEMINI_QUIZ_API_KEY=
# QUIZ_MODEL=gemini-3.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_TIMEOUT_MS=15000

# Optional: Chromium/Chrome path for npm run test:browser (Playwright)
# BROWSER_EXECUTABLE=

# Optional: "Ask AI" brief refinement tries xAI Grok first when this is set, which sends the business's brief text to xAI.
# Leave it empty to use Gemini only.
# GROK_API_KEY=
# GROK_MODEL=grok-beta
