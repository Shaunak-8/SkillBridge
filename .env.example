# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=skillbridge
NEXT_PUBLIC_DEMO_MODE=true

# Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
APP_URL=http://localhost:3000

# Member 2 Gemini generator, server-only. Never use a NEXT_PUBLIC prefix.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_MS=15000

# Supabase
# Create these values in Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase secret. Never expose this to browser code.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
