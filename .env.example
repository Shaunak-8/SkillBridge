# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Application
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=skillbridge
NEXT_PUBLIC_DEMO_MODE=true

# Neon Auth (server-only)
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Google Gemini generation and embeddings (server-only)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=15000
EMBEDDING_MODEL=gemini-embedding-001
# AI quiz generation and grading (server-only). Falls back to GEMINI_API_KEY when empty.
GEMINI_QUIZ_API_KEY=
# QUIZ_MODEL=gemini-3.5-flash

# Optional OpenAI-compatible generation provider (server-only)
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# Optional xAI Grok provider used by brief refinement (server-only)
# GROK_API_KEY=
# GROK_MODEL=

# CometChat. API and sync secrets must remain server-only.
NEXT_PUBLIC_ENABLE_CHAT=false
NEXT_PUBLIC_COMETCHAT_APP_ID=
NEXT_PUBLIC_COMETCHAT_REGION=
COMETCHAT_API_KEY=
COMETCHAT_SYNC_SECRET=GENERATE_A_RANDOM_SECRET

# Optional local browser-test configuration
# BROWSER_EXECUTABLE=
# TEST_EMAIL=
# TEST_PASSWORD=
# TEST_FULL_NAME=
# TEST_ROLE=

# AI technical interview (server-only)
GEMINI_INTERVIEW_API_KEY=
APP_URL=http://localhost:3000
EMBEDDING_API_KEY=
