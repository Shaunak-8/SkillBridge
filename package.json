{
  "name": "skillbridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:client-secrets": "node scripts/check-client-secrets.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
