    "db:seed": "node scripts/seed.mjs",
    "db:seed:ws5": "node scripts/seed-ws5.mjs",
    "db:embed:ws5": "tsx --conditions react-server scripts/backfill-embeddings.ts",
    "db:index": "tsx --conditions react-server scripts/index-knowledge.ts",
    "db:check": "tsx --conditions react-server scripts/check-neon.ts",
    "test:backend": "node scripts/test-backend.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:db": "node scripts/test-database.mjs",
